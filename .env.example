# Local development only. Replace infrastructure settings before any public deployment.
VIESETT_ENVIRONMENT=development
VIESETT_DATABASE_URL=postgresql+asyncpg://viesett:development-only@localhost:5432/viesett
VIESETT_TEST_DATABASE_URL=postgresql+asyncpg://viesett:development-only@localhost:5432/viesett_test
# Explicit test double opt-in; never enable in production.
VIESETT_ALLOW_DEVELOPMENT_SAFETY=true
# Leave archive purge disabled until a product/legal retention decision is made.
# VIESETT_ARCHIVED_RETENTION_DAYS=90
# Explicitly requested official/public property lookups; no document content is sent.
VIESETT_OFFICIAL_SOURCES_ENABLED=true
# Production only: set true after reviewing roles, terms, disclosure and deployment.
VIESETT_OFFICIAL_SOURCES_REVIEWED=false
# Optional; anonymous GRAR reads are supported. Never commit a real key.
# VIESETT_GRAR_API_KEY=
# Opt-in example-address smoke test, never needed by normal CI.
VIESETT_RUN_LIVE_SOURCE_TESTS=false

# Local text-layer PDF processing; no external OCR/AI credentials.
VIESETT_PDF_MAX_PAGES=150
VIESETT_PDF_MAX_CHARACTERS=500000
VIESETT_PDF_MAX_STREAM_BYTES=4194304
VIESETT_PDF_TIMEOUT_SECONDS=8
